#!/bin/sh
# THE WALL BEHIND THE DOOR. Installed by `make hooks`; lives in the common `.git`, so it covers every
# worktree of this clone — the workers' included, and they do not read the README.
#
# Why it exists, 2026-11-28: `scripts/ship.sh` is the polite way to push, and a raw `git push` does not
# go through it. On 2026-11-27 one did: `git push origin HEAD:refs/heads/master` put a sheet on the line
# that PUBLISHES and five pipeline runs went red.
#
# Allowed: the integration line, and `w/…` (a worker's backup, which is what a branch push is for).
# `master` PUBLISHES: refused unless ADA_ALLOW_PUBLISH=1 — the operator saying «pubblica».
# Anything else needs ADA_ALLOW_BRANCH=1, and the line says so.
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
		refs/heads/integra-schede-master|refs/heads/w/*) ;;
		refs/heads/master)
			if [ "${ADA_ALLOW_PUBLISH:-0}" != 1 ]; then
				echo "ERROR pre-push: $remote_ref PUBLISHES (publish.yml -> Docker Hub -> Flux)." >&2
				echo "ERROR pre-push: if that is the decision, ADA_ALLOW_PUBLISH=1 sh scripts/ship.sh --publish. Refused." >&2
				status=1
			fi ;;
		*)
			if [ "${ADA_ALLOW_BRANCH:-0}" != 1 ]; then
				echo "ERROR pre-push: refusing $remote_ref — the integration line is integra-schede-master." >&2
				echo "ERROR pre-push: a work branch is refs/heads/w/… ; anything else needs ADA_ALLOW_BRANCH=1." >&2
				status=1
			fi ;;
	esac
done
exit $status
